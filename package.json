{
  "name": "feg-contextflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @feg/mobile",
    "ios": "npm run ios --workspace @feg/mobile",
    "android": "npm run android --workspace @feg/mobile",
    "api": "npm run dev --workspace @feg/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
